#!/usr/bin/env bash
#
# elm-magic 한 번에 릴리즈.
#
#   bash ./release 0.7.5
#
# RELEASING.md 의 수동 절차를 그대로 자동화한다:
#
#   1. 버전 범프   — Cargo.toml 4개 + path 의존성 3곳 + Cargo.lock
#   2. 체인지로그  — CHANGELOG.md 에 새 버전 절 추가 (본문은 --notes / --notes-file,
#                    없으면 마지막 태그 이후 커밋 제목으로 자동 생성)
#   3. 로컬 검증   — cargo fmt --check / cargo test ×2 / cargo package ×4
#   4. 커밋 & 태그 — "chore: release vX.Y.Z" / vX.Y.Z
#   5. 푸시        — git push origin HEAD --tags
#   6. 배포        — elm-magic-macros → elm-magic → elm-magic-egui/gpui,
#                    crates.io 색인 전파를 기다리고, 이미 배포된 버전은 건너뛴다.
#
# crates.io 배포는 되돌릴 수 없으므로, 대화형 실행에서는 시작 전에 한 번 확인한다.
# 중간에 실패해도 다시 실행하면 이미 배포된 크레이트는 건너뛰고 이어서 진행한다.
#
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_ROOT"

# 배포 순서 — 의존성 방향: macros → elm-magic → egui / gpui
CRATES=(elm-magic-macros elm-magic elm-magic-egui elm-magic-gpui)
# 색인 전파 대기 최대 시간(초)
PUBLISH_WAIT="${PUBLISH_WAIT:-180}"

VERSION=""
ASSUME_YES=0
DRY_RUN=0
DO_PUSH=1
DO_PUBLISH=1
DO_TESTS=1
DO_PACKAGE=1
NOTES=""
NOTES_FILE=""

if [[ -t 1 ]]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'
  GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RESET=$'\033[0m'
else
  BOLD=""; DIM=""; RED=""; GREEN=""; YELLOW=""; RESET=""
fi

log()  { printf '%s==>%s %s\n' "$BOLD" "$RESET" "$*"; }
warn() { printf '%swarning:%s %s\n' "$YELLOW" "$RESET" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$RED" "$RESET" "$*" >&2; exit 1; }

# 실제로 실행한다. --dry-run 이면 명령만 출력한다.
run() {
  if (( DRY_RUN )); then
    printf '  %s[dry-run]%s %s\n' "$DIM" "$RESET" "$*"
  else
    printf '  %s$%s %s\n' "$DIM" "$RESET" "$*"
    "$@"
  fi
}

usage() {
  cat <<'EOF'
사용법: bash ./release <버전> [옵션]

  bash ./release 0.7.5              버전 범프 → 검증 → 커밋/태그 → 푸시 → 배포
  bash ./release 0.7.5 --dry-run    아무것도 바꾸지 않고 계획만 출력
  bash ./release 0.7.5 --local      푸시·배포 없이 로컬 커밋/태그까지만

옵션:
  -y, --yes           시작 전 확인 프롬프트를 건너뛴다 (비대화형 필수)
  -n, --dry-run       파일·git·crates.io 를 건드리지 않고 계획만 출력
      --local         --no-push --no-publish 와 같다
      --no-push       태그를 원격에 올리지 않는다
      --no-publish    crates.io 에 배포하지 않는다
      --no-tests      cargo fmt/test 게이트를 건너뛴다
      --no-package    cargo package 게이트를 건너뛴다
      --notes TEXT    체인지로그 본문 (여러 줄 가능)
      --notes-file F  체인지로그 본문을 파일에서 읽는다
  -h, --help          이 도움말

환경 변수:
  PUBLISH_WAIT        색인 전파 대기 최대 초 (기본 180)
  CARGO_REGISTRY_TOKEN  crates.io 토큰 (없으면 ~/.cargo/credentials.toml 사용)

EOF
}

# ── 인자 파싱 ────────────────────────────────────────────────────────────────
parse_args() {
  while (($#)); do
    case "$1" in
      -y|--yes)       ASSUME_YES=1 ;;
      -n|--dry-run)   DRY_RUN=1 ;;
      --local)        DO_PUSH=0; DO_PUBLISH=0 ;;
      --no-push)      DO_PUSH=0 ;;
      --no-publish)   DO_PUBLISH=0 ;;
      --no-tests)     DO_TESTS=0 ;;
      --no-package)   DO_PACKAGE=0 ;;
      --notes)        shift; NOTES="${1:-}" ;;
      --notes-file)   shift; NOTES_FILE="${1:-}" ;;
      -h|--help)      usage; exit 0 ;;
      -*)             die "알 수 없는 옵션: $1 (--help 참고)" ;;
      *)              [[ -z "$VERSION" ]] || die "버전이 두 번 주어졌습니다: $1"
                      VERSION="$1" ;;
    esac
    shift
  done
  [[ -n "$VERSION" ]] || { usage; die "버전을 지정하세요 (예: bash ./release 0.7.5)"; }
  [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] \
    || die "버전 형식이 잘못되었습니다: $VERSION (예: 0.7.5)"
}

# ── 현재 상태 읽기 ───────────────────────────────────────────────────────────
current_version() {
  sed -nE 's/^version = "([^"]+)"$/\1/p' Cargo.toml | head -n1
}

tag_exists() { git rev-parse -q --verify "refs/tags/v$VERSION" >/dev/null 2>&1; }

tag_points_at_head() {
  [[ "$(git rev-parse "v$VERSION^{commit}" 2>/dev/null || true)" == "$(git rev-parse HEAD)" ]]
}

# crates.io 에 해당 버전이 이미 있는가? (curl 없으면 "없음"으로 본다)
crate_published() {
  local name="$1"
  command -v curl >/dev/null 2>&1 || return 1
  curl -fsSL -A "elm-magic-release (https://github.com/jaywoo0830a/elm)" \
    "https://crates.io/api/v1/crates/$name" 2>/dev/null \
    | tr -d ' ' | grep -q "\"num\":\"$VERSION\""
}

# ── 사전 점검 ────────────────────────────────────────────────────────────────
preflight() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  local branch; branch="$(git rev-parse --abbrev-ref HEAD)"
  [[ "$branch" != "HEAD" ]] || die "detached HEAD 에서는 릴리즈할 수 없습니다 (브랜치를 확인하세요)"
  if [[ -n "$(git status --porcelain)" ]]; then
    die "작업 트리가 깨끗하지 않습니다 — 먼저 커밋하거나 정리하세요"
  fi
  if tag_exists && ! tag_points_at_head; then
    die "태그 v$VERSION 이 이미 다른 커밋을 가리킵니다 (재실행이면 HEAD 에서 실행하세요)"
  fi
  if (( DO_PUSH )) && ! git remote get-url origin >/dev/null 2>&1; then
    die "원격 'origin' 이 없습니다 (--no-push 로 로컬만 진행할 수 있습니다)"
  fi
  if (( DO_PUBLISH )) && (( ! DRY_RUN )); then
    if [[ -z "${CARGO_REGISTRY_TOKEN:-}" && ! -f "$HOME/.cargo/credentials.toml" ]]; then
      die "crates.io 토큰이 없습니다 — cargo login 또는 CARGO_REGISTRY_TOKEN (--no-publish 사용 가능)"
    fi
  fi
}
# ── 1. 버전 범프 (7곳 + Cargo.lock) ─────────────────────────────────────────
update_lock() {
  local tmp; tmp="$(mktemp)"
  awk -v ver="$VERSION" '
    /^\[\[package\]\]$/ { upgrade = 0 }
    /^name = "elm-magic"$/      || /^name = "elm-magic-macros"$/ ||
    /^name = "elm-magic-egui"$/ || /^name = "elm-magic-gpui"$/ { upgrade = 1 }
    upgrade && /^version = / { print "version = \"" ver "\""; upgrade = 0; next }
    { print }
  ' Cargo.lock > "$tmp"
  if (( DRY_RUN )); then rm -f "$tmp"; else mv "$tmp" Cargo.lock; fi
}

verify_versions() {
  local bad=0 c
  grep -qE "^version = \"$VERSION\"$" Cargo.toml || bad=1
  grep -qF "elm-magic-macros = { path = \"crates/elm-magic-macros\", version = \"$VERSION\" }" Cargo.toml || bad=1
  grep -qE "^version = \"$VERSION\"$" crates/elm-magic-macros/Cargo.toml || bad=1
  for c in elm-magic-egui elm-magic-gpui; do
    grep -qE "^version = \"$VERSION\"$" "crates/$c/Cargo.toml" || bad=1
    grep -qF "elm-magic = { path = \"../..\", version = \"$VERSION\" }" "crates/$c/Cargo.toml" || bad=1
  done
  for c in "${CRATES[@]}"; do
    grep -A1 "^name = \"$c\"$" Cargo.lock | grep -q "^version = \"$VERSION\"$" || bad=1
  done
  (( bad == 0 )) || die "버전 동기화 실패 — Cargo.toml / Cargo.lock 을 확인하세요"
}

bump_versions() {
  log "버전 범프: $(current_version) → $VERSION"
  run sed -i -E "s|^version = \"[^\"]*\"$|version = \"$VERSION\"|" Cargo.toml
  run sed -i -E \
    "s|(elm-magic-macros = \{ path = \"crates/elm-magic-macros\", version = \")[^\"]*(\")|\1$VERSION\2|" Cargo.toml
  run sed -i -E "s|^version = \"[^\"]*\"$|version = \"$VERSION\"|" crates/elm-magic-macros/Cargo.toml
  local c
  for c in elm-magic-egui elm-magic-gpui; do
    run sed -i -E "s|^version = \"[^\"]*\"$|version = \"$VERSION\"|" "crates/$c/Cargo.toml"
    run sed -i -E \
      "s|(elm-magic = \{ path = \"\.\./\.\.\", version = \")[^\"]*(\")|\1$VERSION\2|" "crates/$c/Cargo.toml"
  done
  update_lock
  (( DRY_RUN )) || verify_versions
}
# ── 2. 체인지로그 ───────────────────────────────────────────────────────────
auto_notes() {
  local prev=""
  prev="$(git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || true)"
  [[ -n "$prev" ]] || return 0
  git log --no-merges --pretty='- %s' "$prev..HEAD" 2>/dev/null | grep -vE '^- chore: release ' || true
}

changelog_body() {
  if [[ -n "$NOTES_FILE" ]]; then
    [[ -r "$NOTES_FILE" ]] || die "본문 파일을 읽을 수 없습니다: $NOTES_FILE"
    cat "$NOTES_FILE"
  elif [[ -n "$NOTES" ]]; then
    printf '%s\n' "$NOTES"
  else
    local notes; notes="$(auto_notes)"
    [[ -n "$notes" ]] || notes="- (기록할 변경 사항을 찾지 못했습니다)"
    printf '%s\n' "$notes"
  fi
}

update_changelog() {
  if grep -qE "^## \[$VERSION\]" CHANGELOG.md 2>/dev/null; then
    log "CHANGELOG.md 에 [$VERSION] 항목이 이미 있습니다 — 그대로 둡니다"
    return 0
  fi
  if (( DRY_RUN )); then
    printf '  %s[dry-run]%s CHANGELOG.md 에 [%s] 절 추가\n' "$DIM" "$RESET" "$VERSION"
    return 0
  fi
  local entry tmp
  entry="$(mktemp)"; tmp="$(mktemp)"
  {
    printf '## [%s] — %s\n\n' "$VERSION" "$(date +%F)"
    printf '### Changed\n\n'
    changelog_body
    printf '\n'
  } > "$entry"
  if grep -q '^## \[' CHANGELOG.md; then
    awk -v f="$entry" '
      /^## \[/ && !done { while ((getline line < f) > 0) print line; close(f); done = 1 }
      { print }
    ' CHANGELOG.md > "$tmp"
  else
    cat CHANGELOG.md > "$tmp"
    printf '\n' >> "$tmp"
    cat "$entry" >> "$tmp"
  fi
  mv "$tmp" CHANGELOG.md
  rm -f "$entry"
  log "CHANGELOG.md 에 [$VERSION] 절 추가"
}

# ── 3. 로컬 검증 ────────────────────────────────────────────────────────────
run_tests() {
  if (( ! DO_TESTS )); then log "테스트 건너뜀 (--no-tests)"; return 0; fi
  log "로컬 검증: cargo fmt --check / cargo test"
  run cargo fmt --all --check
  run cargo test --workspace
  run cargo test --workspace --all-features
}

run_package() {
  if (( ! DO_PACKAGE )); then log "포장 검증 건너뜀 (--no-package)"; return 0; fi
  log "포장 검증: cargo package ×4 (패치는 검증 전용 — Cargo.toml 에 남기지 않는다)"
  run cargo package --allow-dirty -p elm-magic-macros
  run cargo package --allow-dirty -p elm-magic \
    --config 'patch.crates-io.elm-magic-macros.path="crates/elm-magic-macros"'
  local c
  for c in elm-magic-egui elm-magic-gpui; do
    run cargo package --allow-dirty -p "$c" \
      --config 'patch.crates-io.elm-magic.path="."' \
      --config 'patch.crates-io.elm-magic-macros.path="crates/elm-magic-macros"'
  done
}
# ── 4. 커밋 & 태그 ──────────────────────────────────────────────────────────
commit_and_tag() {
  log "커밋 & 태그: v$VERSION"
  if [[ -z "$(git status --porcelain)" ]]; then
    log "변경 사항 없음 — 커밋 건너뜀"
  else
    run git add -A
    run git commit -m "chore: release v$VERSION"
  fi
  if tag_exists; then
    log "태그 v$VERSION 이 이미 있습니다 — 건너뜀"
  else
    run git tag "v$VERSION"
  fi
}

# ── 5. 푸시 ─────────────────────────────────────────────────────────────────
push() {
  if (( ! DO_PUSH )); then log "푸시 건너뜀 (--no-push)"; return 0; fi
  log "푸시: git push origin HEAD --tags"
  run git push origin HEAD --tags
}

# ── 6. crates.io 배포 ───────────────────────────────────────────────────────
publish_crate() {
  local crate="$1"
  if crate_published "$crate"; then
    log "이미 배포됨: $crate $VERSION — 건너뜀"
    return 0
  fi
  if (( DRY_RUN )); then
    printf '  %s[dry-run]%s cargo publish -p %s\n' "$DIM" "$RESET" "$crate"
    return 0
  fi
  log "배포: $crate $VERSION"
  local out
  if ! out="$(cargo publish -p "$crate" 2>&1)"; then
    printf '%s\n' "$out"
    if grep -qiE 'already (uploaded|exists)|crate version .* is already' <<<"$out"; then
      warn "crates.io 가 이미 배포된 버전으로 응답했습니다 — 건너뜀"
      return 0
    fi
    die "배포 실패: $crate"
  fi
  printf '%s\n' "$out"
}

wait_for_version() {
  local name="$1" waited=0
  if (( DRY_RUN )); then
    printf '  %s[dry-run]%s crates.io 색인 대기: %s %s\n' "$DIM" "$RESET" "$name" "$VERSION"
    return 0
  fi
  crate_published "$name" && return 0
  log "crates.io 색인 전파 대기: $name $VERSION (최대 ${PUBLISH_WAIT}s)"
  while (( waited < PUBLISH_WAIT )); do
    sleep 5; waited=$((waited + 5))
    if crate_published "$name"; then log "전파 확인 (${waited}s)"; return 0; fi
  done
  die "색인 전파 대기 초과: $name $VERSION — 잠시 후 같은 명령을 다시 실행하세요"
}

publish_all() {
  if (( ! DO_PUBLISH )); then log "배포 건너뜀 (--no-publish)"; return 0; fi
  log "crates.io 배포 (순서: ${CRATES[*]})"
  publish_crate elm-magic-macros
  wait_for_version elm-magic-macros
  publish_crate elm-magic
  wait_for_version elm-magic
  publish_crate elm-magic-egui
  publish_crate elm-magic-gpui
}
# ── 진행 요약 / 확인 ────────────────────────────────────────────────────────
summary() {
  local branch stages="범프 → 체인지로그" c
  branch="$(git rev-parse --abbrev-ref HEAD)"
  if (( DO_TESTS ));   then stages+=" → fmt/test";      else stages+=" → fmt/test(생략)"; fi
  if (( DO_PACKAGE )); then stages+=" → package";       else stages+=" → package(생략)"; fi
  stages+=" → 커밋/태그"
  if (( DO_PUSH ));    then stages+=" → 푸시";          else stages+=" → 푸시(생략)"; fi
  if (( DO_PUBLISH )); then stages+=" → 배포";          else stages+=" → 배포(생략)"; fi

  printf '%s\n' "──────────────────────────────────────────────────────────────"
  printf '%selm-magic 릴리즈 v%s%s\n' "$BOLD" "$VERSION" "$RESET"
  printf '  저장소    : %s\n' "$REPO_ROOT"
  printf '  브랜치    : %s\n' "$branch"
  printf '  현재 버전 : %s\n' "$(current_version)"
  if tag_exists; then printf '  태그      : v%s (이미 있음 — 재실행)\n' "$VERSION"
  else               printf '  태그      : v%s (새로 생성)\n' "$VERSION"; fi
  printf '  크레이트  :'
  for c in "${CRATES[@]}"; do
    if crate_published "$c"; then printf ' %s(배포됨)' "$c"; else printf ' %s' "$c"; fi
  done
  printf '\n'
  printf '  단계      : %s\n' "$stages"
  printf '%s\n' "──────────────────────────────────────────────────────────────"
}

confirm() {
  (( DRY_RUN )) && return 0
  (( ASSUME_YES )) && return 0
  if [[ -t 0 ]]; then
    local ans
    read -r -p "위 내용으로 진행할까요? (crates.io 배포는 되돌릴 수 없습니다) [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || die "취소했습니다"
  else
    die "비대화형 실행에서는 --yes 가 필요합니다 (또는 --local / --dry-run)"
  fi
}

main() {
  parse_args "$@"
  preflight
  summary
  confirm
  bump_versions
  update_changelog
  run_tests
  run_package
  commit_and_tag
  push
  publish_all
  log "완료: v$VERSION"
}

main "$@"